# ── Base de datos ──
# Superusuario: solo para `npm run db:setup` (crea base y roles). En producción puede omitirse tras el setup.
PG_SUPERUSER_URL=postgres://postgres:CAMBIAR@localhost:5432/postgres
# Rol dueño (migraciones, Better Auth, superadmin, jobs). Omite RLS por ser dueño de las tablas.
DATABASE_ADMIN_URL=postgres://cobra_owner:CAMBIAR@localhost:5432/cobra_app
# Rol de la aplicación (NOSUPERUSER NOBYPASSRLS): todas las consultas de negocio pasan por RLS.
DATABASE_URL=postgres://cobra_web:CAMBIAR@localhost:5432/cobra_app

# ── Autenticación ──
BETTER_AUTH_SECRET=generar-con-openssl-rand-base64-32
BETTER_AUTH_URL=https://julietaponz.com
APP_URL=https://julietaponz.com
# Protege /api/jobs/* (crons)
CRON_SECRET=generar-con-openssl-rand-base64-24

# ── Archivos ──
UPLOAD_DIR=/var/data/uploads

# ── Correo (Resend o SMTP; sin ninguno se guardan en ./.data/correos) ──
RESEND_API_KEY=
CORREO_REMITENTE=Dra. Julieta Ponz <no-responder@julietaponz.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Seed inicial ──
SUPERADMIN_EMAIL=superadmin@julietaponz.com
SUPERADMIN_PASSWORD=CAMBIAR
DRA_EMAIL=dra@julietaponz.com
DRA_PASSWORD=CAMBIAR
DEMO_EMAIL=admin@demodentista.com
DEMO_PASSWORD=CAMBIAR

# ── Landing pública ──
LANDING_ORG_SLUG=dra-ponz
# Número de WhatsApp de la Dra. con código de país, sin + ni espacios (ej. 5917xxxxxxx)
WHATSAPP_LANDING=59100000000
