# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  Variables de entorno. Copia a .env (desarrollo) o cárgalas en Easypanel (producción: ver DEPLOY_EASYPANEL.md).
#  (*) = obligatoria. La app y el worker las validan al arrancar y fallan con un mensaje claro si falta alguna.
# ═══════════════════════════════════════════════════════════════════════════════════════════════

# ── Entorno ──
# (*) production en el servidor (el Dockerfile ya la pone).
NODE_ENV=production
# Zona horaria del servidor (el Dockerfile ya la pone; los crons usan America/La_Paz igual).
TZ=America/La_Paz

# ── Base de datos (Postgres) ──
# (*) Rol de la APP: sujeto a RLS (sin superusuario ni BYPASSRLS). Si no existe, se crea solo al arrancar con este
#     usuario y contraseña. En Easypanel el host es el del servicio Postgres (p. ej. dra-ponz_postgres).
DATABASE_URL=postgres://cobra_web:CAMBIAR@dra-ponz_postgres:5432/cobra_app
# (*) Rol DUEÑO: migraciones, autenticación, jobs y backups. En Easypanel: el usuario del servicio Postgres.
#     Debe ser un usuario DISTINTO al de DATABASE_URL. (DATABASE_ADMIN_URL es el nombre anterior y también vale.)
DATABASE_URL_OWNER=postgres://postgres:CAMBIAR@dra-ponz_postgres:5432/cobra_app
# Conexiones por pool y proceso (por defecto 10). Regla: procesos × 2 × DB_POOL_MAX < max_connections (100).
DB_POOL_MAX=10
# Solo desarrollo local: superusuario para crear la base y los roles (npm run db:setup).
PG_SUPERUSER_URL=postgres://postgres:CAMBIAR@localhost:5432/postgres

# ── Autenticación ──
# (*) Secreto de sesiones y firmas (≥ 32 caracteres): openssl rand -base64 32
BETTER_AUTH_SECRET=generar-con-openssl-rand-base64-32
# (*) URL pública del sitio, con https (la misma que APP_URL).
BETTER_AUTH_URL=https://julietaponz.com
# (*) URL pública: enlaces del portal, correos, sitemap e imagen para compartir.
APP_URL=https://julietaponz.com
# Intentos de login por minuto e IP (además del bloqueo por cuenta: 10 fallos → 15 min).
LOGIN_MAX_POR_MINUTO=10

# ── Archivos ──
# (*) Carpeta de comprobantes y archivos subidos: RUTA ABSOLUTA en el Volume Mount de Easypanel (/data). Debe existir
#     y poder escribirse; si no, la app no arranca y lo dice. (El Dockerfile ya pone /data/uploads.)
UPLOAD_DIR=/data/uploads

# ── Correo (uno de los dos; sin ninguno, los correos se guardan en archivos y NO se envían) ──
RESEND_API_KEY=
CORREO_REMITENTE=Dra. Julieta Ponz <no-responder@julietaponz.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Landing ──
# Organización dueña de la landing cuando el dominio no coincide (por defecto dra-ponz).
LANDING_ORG_SLUG=dra-ponz
# Número de WhatsApp de la landing, con código de país y solo números (si la organización no tiene uno).
WHATSAPP_LANDING=591XXXXXXXX

# ── Worker: backups ──
# (*) solo en el Worker: clave para CIFRAR los backups (≥ 32 caracteres): openssl rand -base64 32
#     ¡Guárdala también fuera del servidor! Sin ella no se pueden restaurar.
BACKUP_ENCRYPTION_KEY=
# Carpeta de backups en el volumen (el Dockerfile ya pone /data/backups) y días que se guardan.
BACKUP_DIR=/data/backups
BACKUP_DIAS=14
# Copia fuera del servidor con rclone: nombre del remoto y carpeta. Vacío = solo local (queda una advertencia en el log).
# El remoto se configura con variables RCLONE_CONFIG_<NOMBRE>_* (ejemplo para Backblaze B2 con el remoto "b2"):
RCLONE_REMOTE=
# RCLONE_CONFIG_B2_TYPE=b2
# RCLONE_CONFIG_B2_ACCOUNT=
# RCLONE_CONFIG_B2_KEY=
# y RCLONE_REMOTE=b2:nombre-del-bucket/dra-ponz

# ── Jobs por HTTP (opcional; el worker ya los corre solo) ──
# Si se define (≥ 24 caracteres), permite llamar POST /api/jobs/diario y /api/jobs/tipo-cambio con
# "Authorization: Bearer <CRON_SECRET>". Vacío = esas rutas responden 401.
CRON_SECRET=

# ── Primer arranque: npm run seed:prod ──
# Correo de la Dra.: se crea su organización y su usuaria con una contraseña aleatoria que se muestra UNA vez.
SEED_DRA_EMAIL=
# Dominio de la organización (por defecto julietaponz.com).
SEED_DOMINIO=julietaponz.com

# ── Solo desarrollo (npm run db:seed) ──
# Administradora principal y administradores extra (correo:Nombre:contraseña separados por ";").
DRA_EMAIL=correo@ejemplo.com
DRA_PASSWORD=CAMBIAR
ADMINS_EXTRA=
# Opcionales (las pruebas E2E crean y borran los suyos): SUPERADMIN_EMAIL / SUPERADMIN_PASSWORD · DEMO_EMAIL / DEMO_PASSWORD
# Despliegue con PM2 + el Nginx del repo (no Easypanel): procesos y micro-caché de la landing.
# PM2_INSTANCIAS=2
# LANDING_CACHE_NGINX=1
